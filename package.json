{
  "name": "r-commander-studio",
  "version": "0.1.18",
  "description": "Standalone VS Code-style R + R Markdown IDE with Monaco Editor, 371 R Commander dialogs, R LSP + hover docs, arf & R terminals, interactive Data Viewer, Markdown Viewer, and NoteComplete Bridge",
  "author": "Emefedez <https://github.com/Emefedez>",
  "homepage": "https://github.com/Emefedez/r-commander-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/Emefedez/r-commander-studio.git"
  },
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "sync-rcmdr": "node tools/sync-rcmdr.mjs",
    "screenshots": "node tools/capture-screenshots.mjs",
    "install-desktop": "node -e \"require('./main/linux-integration').integrateLinuxDesktop({ createDesktopShortcut: true }).then(r => console.log('Installed:', r))\"",
    "dist": "node tools/stamp-build.mjs && electron-builder --publish never",
    "dist:dir": "node tools/stamp-build.mjs && electron-builder --dir --publish never",
    "dist:linux": "node tools/stamp-build.mjs && electron-builder --linux --x64 --arm64 --publish never",
    "dist:linux:x64": "node tools/stamp-build.mjs && electron-builder --linux --x64 --publish never",
    "dist:linux:arm64": "node tools/stamp-build.mjs && electron-builder --linux --arm64 --publish never",
    "dist:mac": "node tools/stamp-build.mjs && electron-builder --mac --arm64 --publish never",
    "dist:win": "node tools/stamp-build.mjs && electron-builder --win --x64 --publish never"
  },
  "keywords": [
    "r",
    "rcmdr",
    "r-commander",
    "rmarkdown",
    "monaco",
    "electron",
    "notecomplete",
    "statistics",
    "dracula"
  ],
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.notecomplete.r-commander-studio",
    "productName": "R Commander Studio",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "icon": "assets/icon.png",
    "files": [
      "main/**/*",
      "renderer/**/*",
      "shared/**/*",
      "assets/**/*",
      "vendor/rcmdr/**/*",
      "node_modules/monaco-editor/min/**/*",
      "node_modules/@xterm/xterm/lib/xterm.js",
      "node_modules/@xterm/xterm/css/xterm.css",
      "node_modules/@xterm/addon-fit/lib/addon-fit.js",
      "package.json"
    ],
    "afterPack": "tools/mac-adhoc-sign.cjs",
    "asarUnpack": [
      "vendor/rcmdr/runner.R",
      "vendor/rcmdr/data/rcmdr-names.txt"
    ],
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development;Science;Education"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${os}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"
    }
  }
}
