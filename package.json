{
  "name": "r-commander-studio",
  "version": "0.1.0",
  "description": "Standalone VS Code-style R + R Markdown IDE with Monaco Editor, 371 R Commander dialogs, R LSP + hover docs, arf & R terminals, interactive Data Viewer, and NoteComplete Bridge",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "sync-rcmdr": "node tools/sync-rcmdr.mjs",
    "screenshots": "node tools/capture-screenshots.mjs",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux --x64 --arm64",
    "dist:linux:x64": "electron-builder --linux --x64",
    "dist:linux:arm64": "electron-builder --linux --arm64",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win --x64"
  },
  "keywords": [
    "r",
    "rcmdr",
    "r-commander",
    "rmarkdown",
    "monaco",
    "electron",
    "notecomplete",
    "statistics",
    "dracula"
  ],
  "license": "MIT",
  "dependencies": {
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.notecomplete.r-commander-studio",
    "productName": "R Commander Studio",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "icon": "assets/icon.png",
    "files": [
      "main/**/*",
      "renderer/**/*",
      "shared/**/*",
      "assets/**/*",
      "vendor/rcmdr/**/*",
      "node_modules/monaco-editor/min/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "vendor/rcmdr/runner.R",
      "vendor/rcmdr/data/rcmdr-names.txt"
    ],
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "Development;Science;Education"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
