{
  "name": "r-commander-studio",
  "version": "0.1.0",
  "description": "Standalone lightweight R + Markdown IDE with Monaco Editor, 371 R Commander dialogs, live diagnostics, SVG plots, and NoteComplete Bridge",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "sync-rcmdr": "node tools/sync-rcmdr.mjs",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "keywords": [
    "r",
    "rcmdr",
    "r-commander",
    "rmarkdown",
    "monaco",
    "electron",
    "notecomplete",
    "statistics"
  ],
  "license": "MIT",
  "dependencies": {
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.notecomplete.r-commander-studio",
    "productName": "R Commander Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "vendor/rcmdr/**/*",
      "node_modules/monaco-editor/min/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "vendor/rcmdr/runner.R",
      "vendor/rcmdr/data/rcmdr-names.txt"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development;Science;Education"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
